# Works immediately with no model, key or network access after installation.
BANKOPS_PROVIDER=extractive
BANKOPS_RETRIEVER=lexical
BANKOPS_RUNTIME=runtime
BANKOPS_API_KEY=
BANKOPS_API_URL=http://127.0.0.1:8000
# Optional real LLM: pip install -e '.[gigachat]'
# BANKOPS_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Keep TLS verification enabled; install the official CA certificates.
# GIGACHAT_CA_BUNDLE_FILE=/absolute/path/to/ca-bundle.pem
# Optional Ollama / vLLM / other OpenAI-compatible server:
# BANKOPS_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
# Optional multilingual dense retrieval (downloads model on first use):
# pip install -e '.[semantic]'
# BANKOPS_RETRIEVER=semantic
BANKOPS_EMBED_MODEL=intfloat/multilingual-e5-small
